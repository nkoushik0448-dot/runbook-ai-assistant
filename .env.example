# Runbook AI Assistant — optional LLM configuration (local Ollama).
#
# POST /ask-ai answers with a local Ollama model — no API key, no
# account, nothing leaves your machine. Copy this file to `.env` to
# change the defaults, or export the variables in your shell:
#   export OLLAMA_HOST="http://localhost:11434"
#   export OLLAMA_MODEL="llama3.2:3b"
#
# The .env file is gitignored. Ollama itself must be running:
#   ollama serve          # in a separate terminal, if not already running
#   ollama pull llama3.2:3b
#
# If Ollama is not running, POST /ask-ai returns a clear 503 and the
# deterministic POST /ask endpoint keeps working with no Ollama at all.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
